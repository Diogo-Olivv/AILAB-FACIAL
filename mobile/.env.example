# =============================================================================
# AILAB-FACIAL — Mobile (Expo Android) Configuration (.env.example)
# =============================================================================

# URL do Backend FastAPI (sem barra final)
EXPO_PUBLIC_API_BASE_URL=https://your-api-domain.run.app

# Chave restrita de inferência do kiosk (POST /recognize)
EXPO_PUBLIC_KIOSK_KEY=your-kiosk-api-key-here

# Supabase (apenas leitura pública de perfis ativos e sessões abertas via RLS)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
