# =============================================================================
# AILAB-FACIAL — Mobile (Expo Android) Configuration (.env.example)
# =============================================================================

# URL do Backend FastAPI
EXPO_PUBLIC_API_URL=https://ailab-facial-backend-xxxx.a.run.app/api/v1

# Chave de autenticação com o backend (deve ser igual a API_KEY do backend)
EXPO_PUBLIC_API_KEY=your-backend-api-key-here

# PIN de 4 dígitos para os tutores autorizarem o cadastro de novos membros no tablet
EXPO_PUBLIC_TUTOR_PIN=1234

# Supabase (apenas leitura de perfis ativos e sessões abertas)
EXPO_PUBLIC_SUPABASE_URL=https://jbahfjfvyomayrmytpdk.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
