{
  "expo": {
    "name": "AILAB Presença",
    "slug": "ailab-facial",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "ailab-facial",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.edu.ailab.facial"
    },
    "android": {
      "package": "br.edu.ailab.facial",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#1E2D5F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "updates": {
      "url": "https://u.expo.dev/b2e1a478-5e3f-4b3f-8a75-e487de512672"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-audio",
      "expo-asset",
      "expo-font",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b2e1a478-5e3f-4b3f-8a75-e487de512672"
      }
    }
  }
}
