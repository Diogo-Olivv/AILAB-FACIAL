# =============================================================================
# AILAB-FACIAL — Backend Configuration (.env.example)
# Copie este arquivo para .env e preencha as credenciais antes de executar.
# =============================================================================

# Supabase (Banco de Dados e Storage)
SUPABASE_URL=https://jbahfjfvyomayrmytpdk.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# Autenticação da API (Kiosk Tablet e Tutores)
API_KEY=generate-a-strong-random-secret-key-32-bytes

# Biometria Calibrada & Antifraude (InsightFace buffalo_s)
FACE_THRESHOLD=0.80
FACE_MIN_COSINE=0.68
MIN_FACE_SIZE=80
MIN_LAPLACIAN_VAR=70.0
LIVENESS_ENABLED=true
LIVENESS_MIN_SCORE=0.60
ENROLL_MAX_PAIRWISE_DISTANCE=0.40
MAX_ENROLL_FRAMES=5

# Sessões, Concorrência e Debounce Anti-Flip-Flop
DEBOUNCE_SECONDS=60
MAX_SESSION_HOURS=10
MAX_SESSION_CAP_HOURS=4

# Busca Vetorial no Postgres (pgvector HNSW)
USE_PGVECTOR=true

# Google Cloud Run & Cloud Scheduler OIDC
SERVICE_URL=https://ailab-facial-backend-xxxx.a.run.app
CLOUD_SCHEDULER_SA_EMAIL=ailab-scheduler@your-gcp-project.iam.gserviceaccount.com
GCP_PROJECT_NUMBER=your-gcp-project-number

# Diretório dos modelos ONNX
INSIGHTFACE_ROOT=~/.insightface
