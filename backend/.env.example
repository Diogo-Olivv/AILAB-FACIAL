# =============================================================================
# AILAB-FACIAL — configuração do backend (exemplo)
#
# Copie para backend/.env. NÃO versione o arquivo .env.
# Os valores abaixo são os PADRÕES DO CÓDIGO (backend/app/config.py), não
# valores calibrados. A lista completa e atualizada está em
# docs/reference/env-vars.md (gerada a partir do código).
# =============================================================================

# Ambiente: "production" liga os controles fail-closed (PAD obrigatório, replay em banco).
ENVIRONMENT=development

# Supabase (banco e autenticação). Use o projeto de TESTE para desenvolvimento.
SUPABASE_URL=https://<seu-projeto>.supabase.co
SUPABASE_SERVICE_KEY=<chave-de-servico-do-supabase>

# Segredos da API. Gere valores fortes e únicos por ambiente.
# ADMIN_API_KEY: manutenção (X-Admin-Key).
# CHALLENGE_SECRET: assinatura dos desafios de captura.
# BIOHASHING_SEED: semente de rotação dos templates. Não troque sem plano (ver docs/how-to/rotate-secrets.md).
ADMIN_API_KEY=<gerar-valor-aleatorio>
CHALLENGE_SECRET=<gerar-valor-aleatorio>
BIOHASHING_SEED=<gerar-valor-aleatorio>

# Origens do painel web (separadas por vírgula). Vazio = nenhuma origem permitida.
CORS_ORIGINS=http://localhost:5173

# Reconhecimento: padrões do código.
FACE_THRESHOLD=0.87
FACE_MIN_COSINE=0.62
FACE_UNCERTAIN_COSINE=0.55
MIN_FACE_SIZE=40
MIN_LAPLACIAN_VAR=20.0
LIVENESS_ENABLED=true
LIVENESS_MIN_SCORE=0.45
ENROLL_MAX_PAIRWISE_DISTANCE=0.82
MAX_ENROLL_FRAMES=5
USE_PGVECTOR=true

# Sessões e debounce.
DEBOUNCE_SECONDS=60
MAX_SESSION_HOURS=10

# Google Cloud (validação OIDC do Cloud Scheduler). Preencha com valores reais do seu projeto.
SERVICE_URL=https://<url-do-servico>.run.app
CLOUD_SCHEDULER_SA_EMAIL=<conta-de-servico>@<projeto>.iam.gserviceaccount.com
GCP_PROJECT_NUMBER=<numero-do-projeto>

# Diretório dos modelos ONNX (gerados por backend/scripts/download_models.py).
INSIGHTFACE_ROOT=~/.insightface
